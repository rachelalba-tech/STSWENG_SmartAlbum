#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

exec bash -c '
  set -euo pipefail

  export FIGMA="${FIGMA:-1}"
  if [[ "$PORT" == "3101" ]]; then
    export API_PORT=3102
  else
    export API_PORT=3101
  fi

  cleanup() {
    trap - EXIT INT TERM
    kill "$api_pid" "$web_pid" 2>/dev/null || true
    wait "$api_pid" "$web_pid" 2>/dev/null || true
  }

  trap cleanup EXIT INT TERM

  npm --prefix server start &
  api_pid=$!

  (
    cd frontend
    exec npm exec -- vite --host 0.0.0.0 --port "$PORT" --strictPort
  ) &
  web_pid=$!

  wait -n "$api_pid" "$web_pid"
'
